{
  "name": "homecast",
  "version": "0.9.1",
  "description": "Self-hosted Chromecast streaming for your home network",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-include=\"routes/**\" --test-coverage-include=server.js \"test/*.test.js\"",
    "test:server": "node --test test/server.test.js test/server-proxy.test.js",
    "test:proxy": "node --test test/proxy.test.js",
    "test:cache": "node --test test/cache.test.js",
    "test:extract": "node --test test/media-scan.test.js test/stream-finder.test.js",
    "test:security": "node --test test/security.test.js",
    "test:dash": "node --test test/dash.test.js",
    "test:playlist": "node --test test/playlist.test.js",
    "test:edge-cases": "node --test test/edge-cases.test.js",
    "test:performance": "node --test test/performance.test.js",
    "test:advanced": "node --test test/stream-detection.test.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "typecheck": "tsc --project jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "NODE_ENV=development node server.js",
    "release:patch": "./release.sh patch",
    "release:minor": "./release.sh minor",
    "release:major": "./release.sh major"
  },
  "keywords": [
    "chromecast",
    "casting",
    "streaming",
    "hls",
    "m3u8",
    "video",
    "self-hosted",
    "homelab"
  ],
  "author": "HomeCast Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simno/homecast.git"
  },
  "bugs": {
    "url": "https://github.com/simno/homecast/issues"
  },
  "homepage": "https://github.com/simno/homecast#readme",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "castv2-client": "^1.2.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mdns-js": "1.0.3",
    "playwright": "^1.63.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "semver": "^7.7.3",
    "protobufjs": "^7.6.5"
  }
}
